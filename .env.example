# Copy to .env and fill in. Never commit .env.

# --- OpenAI Realtime (the voice) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=alloy

# --- Twilio / public URL ---
# Your ngrok host without https://, e.g. abcd-12-34.ngrok-free.app
PUBLIC_HOST=
COMPANY_NAME=Swift Movers

# --- Switch handoff ---
# mattermost_api | mattermost | telegram | console
SWITCH_POST_MODE=console
SWITCH_REVIEWER_HANDLE=movecall-reviewer

# mattermost_api: post as a real user into the channel Switch bridges to the room.
MATTERMOST_URL=http://localhost:61937
MATTERMOST_LOGIN=
MATTERMOST_PASSWORD=
MATTERMOST_TEAM=
MATTERMOST_CHANNEL=movecall-leads
# Optional: skip the team/channel lookup
MATTERMOST_CHANNEL_ID=

# mattermost (incoming webhook) alternative
MATTERMOST_WEBHOOK_URL=

# telegram alternative
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
